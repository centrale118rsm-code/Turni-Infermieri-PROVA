rules_version = '2';

// Regole del progetto creazione-turni-118 (app Turni Infermieri ufficiale e PROVA,
// portale Richieste-INF.-118). Tutte le app entrano con l'accesso anonimo di Firebase.
// Senza un login vero non si può distinguere il coordinatore da un collega: queste regole
// evitano soprattutto i danni irreparabili (cancellazioni, svuotamenti, documenti estranei).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ── Configurazione e turni ───────────────────────────────────────────
    // Documenti ammessi (con o senza il prefisso "prova_" dell'app di prova):
    // settings, reperibilita, saldi, prefs, push, snapindex, turni_AAAA-MM, anno_AAAA,
    // log_AAAA-MM-GG, snap_… (copie automatiche). "zztest_…" solo per le prove tecniche.
    function knownConfigDoc(id) {
      return id.matches('^(prova_)?(settings|reperibilita|saldi|prefs|push|snapindex|turni_[0-9]{4}-[0-9]{2}|anno_[0-9]{4}|log_[0-9]{4}-[0-9]{2}-[0-9]{2}|snap_[A-Za-z0-9_-]+)$')
          || id.matches('^zztest_[A-Za-z0-9_-]+$');
    }
    function isMonth(id) { return id.matches('^(prova_)?turni_[0-9]{4}-[0-9]{2}$'); }
    // un mese dei turni deve sempre avere la mappa delle caselle
    function validMonth(id) { return !isMonth(id) || request.resource.data.cells is map; }
    // e un mese con molti turni non si può svuotare tutto in un colpo (es. un salvataggio sbagliato)
    function notWiped(id) {
      return !isMonth(id) || !('cells' in resource.data) || resource.data.cells.size() < 50 || request.resource.data.cells.size() > 0;
    }
    match /infermieri26_config/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && knownConfigDoc(docId) && validMonth(docId);
      allow update: if signedIn() && knownConfigDoc(docId) && validMonth(docId) && notWiped(docId);
      // si cancellano solo le copie automatiche vecchie (e i documenti di prova tecnica)
      allow delete: if signedIn() && (docId.matches('^(prova_)?snap_[A-Za-z0-9_-]+$') || docId.matches('^zztest_[A-Za-z0-9_-]+$'));
    }

    // ── Sessioni (pannello accessi) ───────────────────────────────────────
    match /infermieri26_accessi/{sessionId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    // ── "Chi sei?": ogni telefono scrive solo il proprio documento ─────────
    match /infermieri26_identities/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── Portale Richieste ─────────────────────────────────────────────────
    match /richieste_infermieri/{docId} {
      allow read, create, update, delete: if signedIn();
    }
    // scambi turno scritti dal portale per ogni "Cambio turno" (id = id della richiesta);
    // si cancellano quando la richiesta viene ritirata o eliminata
    match /turno_overrides/{docId} {
      allow read, create, update, delete: if signedIn();
    }
    match /note_migliorative/{docId} {
      allow read, create, update, delete: if signedIn();
    }
    // configurazione "Bibbia" del portale: si legge e si modifica, non si cancella
    match /admin_config/{docId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    // ── Monete della ruota e mercato delle fasce ───────────────────────────
    // Collezioni nuove, lette solo dall'app che ha le monete ("ns" = "prova_" per la PROVA).
    // Il telefono non può decidere chi esce: ogni giro salva solo l'ora del server (t0, t1, t2)
    // e il vincitore si ricava da quell'ora. Un'estrazione al giorno, senza rifarla né cancellarla.
    function okNs(ns) { return ns == '' || ns == 'prova_'; }
    // nome scelto in "Chi sei?" dal telefono che scrive
    function myName() { return get(/databases/$(database)/documents/infermieri26_identities/$(request.auth.uid)).data.name; }
    // interruttore dell'area admin (campo "coinGame" delle impostazioni): spento non si guadagna né si scambia
    function gameOn(ns) {
      let p = /databases/$(database)/documents/infermieri26_config/$(ns + 'settings');
      return !exists(p) || get(p).data.get('coinGame', true) != false;
    }

    match /infermieri26_estrazioni/{eid} {
      function newEstrazione(d) {
        return d.keys().hasOnly(['ns', 'day', 'dayKey', 'endsAt', 'slots', 'people', 'by', 'byUid', 'createdAt'])
            && d.keys().hasAll(['ns', 'day', 'dayKey', 'endsAt', 'slots', 'people', 'by', 'byUid', 'createdAt'])
            && okNs(d.ns)
            && d.day is timestamp && d.day == d.day.date()
            && (d.day == request.time.date() || d.day == request.time.date() - duration.value(1, 'd') || d.day == request.time.date() + duration.value(1, 'd'))
            && eid == d.ns + 'e_' + string(d.day.toMillis())
            && d.dayKey is string
            && d.endsAt is timestamp && d.endsAt > d.day + duration.value(27, 'h') && d.endsAt < d.day + duration.value(31, 'h')
            && d.slots is list && d.slots.size() == 3
            && d.people is list && d.people.size() >= 2 && d.people.size() <= 12 && d.people.toSet().size() == d.people.size()
            && d.by is string && d.by == myName()
            && d.byUid == request.auth.uid && d.createdAt == request.time
            && gameOn(d.ns);
      }
      // un giro alla volta, in ordine, con l'ora del server e senza toccare il resto
      function nextSpin(k, prev) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([k])
            && !(k in resource.data) && resource.data.keys().hasAll(prev)
            && request.resource.data[k] == request.time
            && gameOn(resource.data.ns);
      }
      allow read: if signedIn();
      allow create: if signedIn() && newEstrazione(request.resource.data);
      allow update: if signedIn() && (nextSpin('t0', []) || nextSpin('t1', ['t0']) || nextSpin('t2', ['t0', 't1']));
      allow delete: if false;
    }

    match /infermieri26_mercato/{oid} {
      function est(eid) { return get(/databases/$(database)/documents/infermieri26_estrazioni/$(eid)).data; }
      // offerta: "ti do la mia fascia + N monete per la tua", solo su un'estrazione finita e prima di fine turno
      function newOffer(d) {
        return d.keys().hasOnly(['ns', 'eid', 'from', 'to', 'give', 'take', 'price', 'status', 'createdAt', 'byUid'])
            && d.keys().hasAll(['ns', 'eid', 'from', 'to', 'give', 'take', 'price', 'status', 'createdAt', 'byUid'])
            && okNs(d.ns) && oid.matches(d.ns + 'o_[A-Za-z0-9]+')
            && d.eid is string && est(d.eid).ns == d.ns && est(d.eid).keys().hasAll(['t0', 't1', 't2'])
            && request.time < est(d.eid).endsAt
            && d.from is string && d.to is string && d.from != d.to
            && d.from in est(d.eid).people && d.to in est(d.eid).people && d.from == myName()
            && d.give is int && d.take is int && d.give >= 0 && d.give <= 2 && d.take >= 0 && d.take <= 2 && d.give != d.take
            && d.price is int && d.price >= 1 && d.price <= 100
            && d.status == 'aperta' && d.createdAt == request.time && d.byUid == request.auth.uid
            && gameOn(d.ns);
      }
      // si chiude una volta sola: accetta o rifiuta chi la riceve, annulla chi l'ha fatta
      function closeOffer() {
        let n = request.resource.data;
        return resource.data.status == 'aperta'
            && n.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt', 'doneBy'])
            && n.status in ['accettata', 'rifiutata', 'annullata']
            && n.doneAt == request.time && n.doneBy is string
            && (n.status == 'annullata'
                ? request.auth.uid == resource.data.byUid
                : request.auth.uid != resource.data.byUid && n.doneBy == resource.data.to && myName() == resource.data.to)
            && (n.status != 'accettata' || (request.time < est(resource.data.eid).endsAt && gameOn(resource.data.ns)));
      }
      allow read: if signedIn();
      allow create: if signedIn() && newOffer(request.resource.data);
      allow update: if signedIn() && closeOffer();
      allow delete: if false;
    }

    // ── Calendario ferie desiderate ────────────────────────────────────────
    // Un documento per persona e per anno ("prova_2027_ROSSI"). Lo legge chiunque usi l'app,
    // ma lo scrive solo il telefono che in "Chi sei?" ha scelto proprio quel nome.
    // Giorni: "MM-GG" -> "F" (ferie) o "P" (permesso); note: "MM-GG" -> testo; ok: giorni barrati.
    // In riunione l'admin (password nell'app) scrive anche le colonne degli altri: lo segna in adminBy.
    // Non si cancella: si svuota.
    match /infermieri26_desiderate/{did} {
      function okDesiderate(d) {
        return d.keys().hasOnly(['ns', 'year', 'name', 'days', 'notes', 'ok', 'adminBy', 'byUid', 'updatedAt'])
            && d.keys().hasAll(['ns', 'year', 'name', 'days', 'byUid', 'updatedAt'])
            && okNs(d.ns)
            && d.year is int && d.year >= 2026 && d.year <= 2035
            && did.matches('^(prova_)?[0-9]{4}_[A-Z0-9_]+$') && did.matches('^' + d.ns + string(d.year) + '_.*')
            && d.name is string && (d.name == myName() || ('adminBy' in d && d.adminBy is string && d.adminBy.size() > 0 && d.adminBy.size() <= 60))
            && d.days is map && d.days.size() <= 366
            && (!('notes' in d) || (d.notes is map && d.notes.size() <= 366))
            && (!('ok' in d) || (d.ok is map && d.ok.size() <= 366))
            && d.byUid == request.auth.uid && d.updatedAt == request.time;
      }
      allow read: if signedIn();
      allow create: if signedIn() && okDesiderate(request.resource.data);
      allow update: if signedIn() && okDesiderate(request.resource.data) && resource.data.name == request.resource.data.name;
      allow delete: if false;
    }

    // ── Storico delle ferie desiderate ─────────────────────────────────────
    // Una riga per ogni salvataggio: data e ora del server (at), dispositivo (by = nome di "Chi sei?",
    // es. "PC Pronto Soccorso"), operatore che ha inserito (op), colonna (col) e giorni cambiati.
    // Si scrive soltanto: non si modifica e non si cancella.
    match /infermieri26_desiderate_log/{lid} {
      function okLog(d) {
        return d.keys().hasOnly(['ns', 'year', 'col', 'by', 'op', 'days', 'notes', 'byUid', 'at'])
            && d.keys().hasAll(['ns', 'year', 'col', 'by', 'op', 'days', 'byUid', 'at'])
            && okNs(d.ns) && lid.matches('^' + d.ns + 'l_[A-Za-z0-9]+$')
            && d.year is int && d.year >= 2026 && d.year <= 2035
            && d.col is string && d.col.size() > 0 && d.col.size() <= 60
            && d.by is string && d.by == myName()
            && d.op is string && d.op.size() > 0 && d.op.size() <= 60
            && d.days is map && d.days.size() <= 366
            && (!('notes' in d) || (d.notes is map && d.notes.size() <= 366))
            && d.byUid == request.auth.uid && d.at == request.time;
      }
      allow read: if signedIn();
      allow create: if signedIn() && okLog(request.resource.data);
      allow update, delete: if false;
    }

    // ── Tutto il resto è chiuso ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
